# Copy to .env.local for `npm run dev`. On Vercel, add the same variable with: vercel env add ANTHROPIC_API_KEY
# Never commit the real key, and never prefix it with VITE_ (that would ship it to every visitor's browser).
ANTHROPIC_API_KEY=

# Optional best-effort limits for the assistant (defaults shown)
# CHAT_REQUESTS_PER_10_MIN=40
# CHAT_DAILY_CAP=4000
